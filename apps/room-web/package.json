{
  "name": "@rivus/room-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:workspace-deps": "pnpm --filter @rivus/agent-orchestration build && pnpm --filter @rivus/agent-room build && pnpm --filter @rivus/agent-task-loop build && pnpm --filter @rivus/agent-finder-core build",
    "prebuild": "pnpm build:workspace-deps",
    "predev": "pnpm build:workspace-deps",
    "dev": "remix vite:dev --host 127.0.0.1 --port 3210 --strictPort",
    "build": "remix vite:build",
    "start": "ROOM_LAB_LOCAL=1 HOST=127.0.0.1 PORT=3210 remix-serve ./build/server/index.js",
    "pretest": "pnpm build:workspace-deps",
    "test": "vitest run",
    "pretypecheck": "pnpm build:workspace-deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@rivus/agent-finder-core": "workspace:*",
    "@rivus/agent-orchestration": "workspace:*",
    "@rivus/agent-room": "workspace:*",
    "@rivus/agent-task-loop": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
