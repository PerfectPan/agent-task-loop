{
  "name": "agent-task-loop-monorepo",
  "private": true,
  "engines": {
    "node": "^26.13.1"
  },
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "agent-finder": "pnpm --filter @rivus/agent-finder-cli dev",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "duplicates": "jscpd --config node_modules/@perfectpan/lint-config/jscpd.json packages apps scripts tests --ignore '**/node_modules/**,**/dist/**,**/.next/**,**/build/**,**/.react-router/**,**/*.test.ts,**/*.test.mjs,**/*.test.tsx' --format 'typescript,javascript,tsx'",
    "duplicates:audit": "jscpd --config node_modules/@perfectpan/lint-config/jscpd-audit.json packages apps scripts tests --absolute --output tmp/duplicates-audit --ignore '**/node_modules/**,**/dist/**,**/.next/**,**/build/**,**/.react-router/**' --format 'typescript,javascript,tsx'",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "knip",
    "knip:production": "knip --production",
    "lint": "vp lint",
    "test": "pnpm peers check --lockfile-only && node --test tests/**/*.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.9.1",
    "vite-plus": "catalog:",
    "jscpd": "5.4.2",
    "knip": "6.45.1"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^26.13.1",
        "onFail": "error"
      }
    ]
  }
}
