{
  "name": "@rivus/room-web",
  "version": "0.0.2",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:workspace-deps": "pnpm --filter @rivus/agent-room build && pnpm --filter @rivus/agent-task-loop build",
    "prebuild": "pnpm build:workspace-deps",
    "predev": "pnpm build:workspace-deps",
    "dev": "react-router dev --host 127.0.0.1 --port 3210 --strictPort",
    "build": "react-router build",
    "start": "ROOM_LAB_LOCAL=1 HOST=127.0.0.1 PORT=3210 react-router-serve ./build/server/index.js",
    "pretest": "pnpm build:workspace-deps",
    "test": "vp test run",
    "pretypecheck": "pnpm build:workspace-deps",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@agentclientprotocol/sdk": "1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@rivus/agent-kit": "0.21.1",
    "@rivus/agent-kit-collab": "0.21.1",
    "@rivus/agent-room": "workspace:*",
    "@rivus/agent-task-loop": "workspace:*",
    "effect": "4.0.5",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-character-count": "^3.33.0",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-hard-break": "^3.33.0",
    "@tiptap/extension-history": "^3.33.0",
    "@tiptap/extension-mention": "^3.33.0",
    "@tiptap/extension-paragraph": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-text": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/suggestion": "^3.33.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "catalog:"
  }
}
