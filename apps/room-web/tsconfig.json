{
  "extends": "../../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@react-router/node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
