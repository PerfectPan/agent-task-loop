{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@perfectpan/lint-config/tsconfig/bundler.json",
  "compilerOptions": {
    "esModuleInterop": true,
    // Off until the existing code is migrated: turning it on reports 95 errors
    // that need case-by-case fixes rather than mechanical ones.
    "noUncheckedIndexedAccess": false
  }
}
