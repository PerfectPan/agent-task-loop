{
  "name": "agent-task-loop-monorepo",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@rivus/agent-finder-cli": "workspace:*",
    "@rivus/agent-task-loop": "workspace:*"
  },
  "scripts": {
    "agent-finder": "pnpm --filter @rivus/agent-finder-cli dev",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "check:moonbit-version": "node scripts/sync-moonbit-version.mjs --check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "release": "pnpm build && changeset publish",
    "sync:moonbit-version": "node scripts/sync-moonbit-version.mjs",
    "test": "node --test tests/**/*.test.mjs && pnpm -r test && moon -C packages/agent-finder test",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version && pnpm sync:moonbit-version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.59.3",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite-plus": "catalog:"
  }
}
